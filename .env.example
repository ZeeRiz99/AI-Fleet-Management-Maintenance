# Copy to .env (git-ignored) and fill in. Never commit real keys.

# ---- FleetLog AI agent (ops/) ----
OPS_DEMO_MODE=1                      # reporter also sees the manager alert copy (one visitor can try the full flow)
OPS_RESTRICT_MANAGER=0               # 1 = only the ids below get manager mode (client deployments)
OPS_MAX_LLM_CALLS_PER_DAY=400        # then the offline router answers
OPS_MAX_MSGS_PER_USER_DAY=200
OPS_MAX_MESSAGE_CHARS=2000

# Telegram bot (phase 2): token from @BotFather; secret = python -m ops.setup_telegram secret
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
OPS_GEMINI_STT_MODEL=                # voice notes; empty = OPS_GEMINI_MODEL
OPS_GROQ_STT_MODEL=whisper-large-v3-turbo

# Manager alert targets (comma separated)
TELEGRAM_MANAGER_CHAT_IDS=
WHATSAPP_MANAGER_NUMBERS=

# LLM providers, tried in this order; any missing one is skipped; none = offline router only
GEMINI_API_KEY=                      # free key: https://aistudio.google.com/apikey
OPS_GEMINI_MODEL=gemini-3.8-flash,gemini-3.5-flash   # tried in order (busy -> next); verify names before deploying
GROQ_API_KEY=                        # free tier: https://console.groq.com
OPS_GROQ_MODEL=openai/gpt-oss-120b,qwen/qwen3.8-27b   # each model has its own free limit (8k tokens/min)
OLLAMA_BASE_URL=                     # e.g. http://localhost:11434/v1 (local only)
OPS_OLLAMA_MODEL=qwen2.5:3b
OPS_LLM_PROVIDER=                    # "offline" forces the keyword router

# Store: Upstash Redis REST (hosted) or a SQLite file (local); neither = in-memory (tests)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
OPS_SQLITE_PATH=data/runtime/ops.db

# ---- Dashboard assistant (src/agent.py) ----
# GEMINI_API_KEY / ANTHROPIC_API_KEY as above; FLEET_LLM_PROVIDER=offline|gemini|anthropic

# ---- Android app chat (phase 5): POST /api/chat with header X-App-Key ----
OPS_APP_KEY=                         # random string; the same value goes in android/local.properties as fleetlog.appKey

# ---- Morning brief + reminders (phase 4): Vercel Cron calls GET /cron/morning ----
CRON_SECRET=                         # random string; Vercel sends it as "Authorization: Bearer <value>"
OPS_BRIEF_HOUR_PKT=8                 # brief hour (PKT); Hobby cron fires within that hour
# Optional automation: every business event is POSTed here (n8n, or docs/fleetlog-ai/automation/google-sheets-log.gs)
OPS_EVENTS_WEBHOOK_URL=
OPS_EVENTS_WEBHOOK_SECRET=

# ---- WhatsApp Cloud API (phase 6): developers.facebook.com > your app > WhatsApp > API Setup ----
# Webhook URL: https://<your-vercel-app>/webhooks/whatsapp  (subscribe to the "messages" field)
WHATSAPP_TOKEN=                      # access token (the 24-hour test token, or a System User token)
WHATSAPP_PHONE_NUMBER_ID=            # "Phone number ID" (not the phone number itself)
WHATSAPP_APP_SECRET=                 # App settings > Basic > App secret (verifies X-Hub-Signature-256)
WHATSAPP_VERIFY_TOKEN=               # any random string; typed into Meta's webhook form too
WHATSAPP_MANAGER_NUMBERS=            # e.g. 923001234567 (comma separated)
WHATSAPP_GRAPH_VERSION=v26.0
WHATSAPP_ALERT_TEMPLATE=             # approved template with one body variable, for alerts outside the 24 h window
WHATSAPP_ALERT_TEMPLATE_LANG=en
